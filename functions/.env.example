# Backend configuration only. Copy to functions/.env.
# production or test; use the matching credentials from MARS.
CCAVENUE_ENV=production
CCAVENUE_MERCHANT_ID=your_merchant_id
CCAVENUE_ACCESS_CODE=your_live_access_code
PAYMENT_SITE_URL=https://bhavansalumniassociation.org
# Production encryption key belongs in Firebase Secret Manager:
# firebase functions:secrets:set CCAVENUE_WORKING_KEY
# Local Functions emulator only: functions/.secret.local contains CCAVENUE_WORKING_KEY=...
